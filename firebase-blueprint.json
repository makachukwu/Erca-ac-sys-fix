{
  "entities": {
    "schools": {
      "title": "School Profile",
      "description": "School institutional profile, financial configuration, and campus fee schedules",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 300 },
        "type": { "type": "string" },
        "currencySymbol": { "type": "string", "maxLength": 10 },
        "classes": { "type": "array" },
        "feeSchedule": { "type": "object" },
        "classFeeSchedules": { "type": "object" },
        "additionalFees": { "type": "array" },
        "sheetConfig": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    },
    "students": {
      "title": "Student Payment Record",
      "description": "Enrolled students with tuition breakdown, payments, arrears, and fee remissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "full_name": { "type": "string", "maxLength": 300 },
        "class": { "type": "string", "maxLength": 100 },
        "term": { "type": "string", "maxLength": 50 },
        "session": { "type": "string", "maxLength": 50 },
        "fee_amount": { "type": "number" },
        "amount_paid": { "type": "number" },
        "balance": { "type": "number" },
        "status": { "type": "string" },
        "payment_date": { "type": "string", "maxLength": 50 },
        "admission_fee": { "type": "number" },
        "admission_paid": { "type": "number" },
        "admission_status": { "type": "string" },
        "is_new_admission": { "type": "boolean" },
        "tuition_fee": { "type": "number" },
        "tuition_paid": { "type": "number" },
        "tuition_status": { "type": "string" },
        "is_exempt_from_school_fee": { "type": "boolean" },
        "scholarship_notes": { "type": "string", "maxLength": 1000 },
        "lesson_fee": { "type": "number" },
        "lesson_paid": { "type": "number" },
        "lesson_status": { "type": "string" },
        "lesson_months": { "type": "string", "maxLength": 100 },
        "exam_fee": { "type": "number" },
        "exam_paid": { "type": "number" },
        "exam_status": { "type": "string" },
        "additional_fees": { "type": "array" },
        "receipt_no": { "type": "string", "maxLength": 100 },
        "total_remitted": { "type": "number" },
        "syncedToCloudAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "full_name", "class", "fee_amount"]
    },
    "scholarships": {
      "title": "Scholarship Record",
      "description": "Scholarship concessions, discounts, and benefactor endorsements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "student_name": { "type": "string", "maxLength": 300 },
        "studentName": { "type": "string", "maxLength": 300 },
        "class": { "type": "string", "maxLength": 100 },
        "studentClass": { "type": "string", "maxLength": 100 },
        "term": { "type": "string", "maxLength": 50 },
        "session": { "type": "string", "maxLength": 50 },
        "scholarship_type": { "type": "string", "maxLength": 200 },
        "scholarship_percentage": { "type": "number" },
        "exempt_school_fee": { "type": "boolean" },
        "scholarship_notes": { "type": "string", "maxLength": 1000 },
        "award_date": { "type": "string", "maxLength": 50 },
        "awarded_by": { "type": "string", "maxLength": 100 },
        "status": { "type": "string" },
        "created_at": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id"]
    },
    "expenses": {
      "title": "School Expense",
      "description": "Operating school expenses, supplies, maintenance, and administrative costs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 100 },
        "categoryLabel": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "recipient": { "type": "string", "maxLength": 200 },
        "receiptVoucherRef": { "type": "string", "maxLength": 100 },
        "term": { "type": "string", "maxLength": 50 },
        "session": { "type": "string", "maxLength": 50 },
        "schoolId": { "type": "string", "maxLength": 256 },
        "recordedBy": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "amount", "category"]
    },
    "staff": {
      "title": "Staff Member",
      "description": "Academic and administrative staff roster, basic salary, and allowances",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "fullName": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 50 },
        "baseSalary": { "type": "number" },
        "allowances": { "type": "object" },
        "deductions": { "type": "object" },
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "accountName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "qualification": { "type": "string", "maxLength": 100 },
        "status": { "type": "string" },
        "employmentType": { "type": "string" },
        "joinedDate": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "fullName", "baseSalary", "department"]
    },
    "payroll": {
      "title": "Payroll Record",
      "description": "Monthly staff payroll disbursement and remittance receipts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "staffId": { "type": "string", "maxLength": 256 },
        "staffName": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 50 },
        "month": { "type": "string", "maxLength": 20 },
        "monthLabel": { "type": "string", "maxLength": 50 },
        "term": { "type": "string", "maxLength": 50 },
        "session": { "type": "string", "maxLength": 50 },
        "baseSalary": { "type": "number" },
        "totalAllowances": { "type": "number" },
        "allowanceBreakdown": { "type": "object" },
        "totalDeductions": { "type": "number" },
        "deductionBreakdown": { "type": "object" },
        "grossPay": { "type": "number" },
        "netPay": { "type": "number" },
        "amountPaid": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "paymentDate": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "referenceNumber": { "type": "string", "maxLength": 100 },
        "processedBy": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "staffId", "month", "netPay"]
    },
    "audit_logs": {
      "title": "Audit Log Entry",
      "description": "Financial and system activity trails with actor metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "readableTime": { "type": "string", "maxLength": 100 },
        "action": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "performer": { "type": "string", "maxLength": 100 },
        "schoolId": { "type": "string", "maxLength": 256 },
        "severity": { "type": "string", "maxLength": 20 },
        "details": { "type": "object" }
      },
      "required": ["id", "timestamp", "action"]
    },
    "term_schedules": {
      "title": "Academic Term Schedule",
      "description": "Academic term dates, fee collection timeline, and salary due calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "term": { "type": "string", "maxLength": 50 },
        "session": { "type": "string", "maxLength": 50 },
        "termStartDate": { "type": "string", "maxLength": 50 },
        "termEndDate": { "type": "string", "maxLength": 50 },
        "salaryDueDay": { "type": "number" },
        "feeCollectionStartDate": { "type": "string", "maxLength": 50 },
        "feeDueDate": { "type": "string", "maxLength": 50 },
        "monthsInTerm": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "term", "termStartDate", "termEndDate"]
    },
    "branding": {
      "title": "School Identity and Branding Configuration",
      "description": "Customized school logos, crests, brand colors, contact details, and receipt footer policies",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "appName": { "type": "string", "maxLength": 300 },
        "shortName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 300 },
        "logoType": { "type": "string" },
        "customLogoData": { "type": "string" },
        "presetEmblem": { "type": "string", "maxLength": 50 },
        "emblemColor": { "type": "string", "maxLength": 50 },
        "primaryColor": { "type": "string", "maxLength": 50 },
        "schoolAddress": { "type": "string", "maxLength": 300 },
        "schoolPhone": { "type": "string", "maxLength": 100 },
        "schoolEmail": { "type": "string", "maxLength": 100 },
        "taxOrRegNo": { "type": "string", "maxLength": 100 },
        "bursarTitle": { "type": "string", "maxLength": 100 },
        "currencySymbol": { "type": "string", "maxLength": 10 },
        "receiptFooterText": { "type": "string", "maxLength": 500 },
        "enableWatermark": { "type": "boolean" },
        "schoolId": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["appName", "primaryColor"]
    },
    "remittances": {
      "title": "Bursar Remittance Record",
      "description": "Bursar fee collection remittances and deposits into management bank accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "method": { "type": "string", "maxLength": 50 },
        "reference": { "type": "string", "maxLength": 100 },
        "referenceNumber": { "type": "string", "maxLength": 100 },
        "remittedBy": { "type": "string", "maxLength": 100 },
        "receivedBy": { "type": "string", "maxLength": 100 },
        "remittedTo": { "type": "string", "maxLength": 200 },
        "bursarName": { "type": "string", "maxLength": 100 },
        "term": { "type": "string", "maxLength": 50 },
        "session": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "status": { "type": "string" },
        "approvalStatus": { "type": "string" },
        "approvedBy": { "type": "string", "maxLength": 100 },
        "approvedAt": { "type": "string", "maxLength": 50 },
        "rejectedBy": { "type": "string", "maxLength": 100 },
        "rejectedAt": { "type": "string", "maxLength": 50 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "submittedBy": { "type": "string", "maxLength": 100 },
        "submittedByRole": { "type": "string", "maxLength": 50 },
        "isVoided": { "type": "boolean" },
        "voidedBy": { "type": "string", "maxLength": 100 },
        "voidedAt": { "type": "string", "maxLength": 50 },
        "voidReason": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "schoolId": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "amount", "date"]
    },
    "system_users": {
      "title": "System User Account",
      "description": "Authorized staff and admin credentials and profile data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "username": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 200 },
        "fullName": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "lastLoginAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "username", "role"]
    },
    "backups": {
      "title": "Term Backup Snapshot",
      "description": "Historical student fee and database snapshots for rollbacks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "term": { "type": "string", "maxLength": 50 },
        "session": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "totalStudents": { "type": "number" },
        "data": { "type": "array" }
      },
      "required": ["id", "term", "session"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": "schools",
      "description": "School institution profiles, settings, and fee schedules"
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": "students",
      "description": "Student enrolled payment records and itemized fee obligations"
    },
    "/schools/{schoolId}/scholarships/{scholarshipId}": {
      "schema": "scholarships",
      "description": "Student scholarship concessions and benefactor discounts"
    },
    "/schools/{schoolId}/expenses/{expenseId}": {
      "schema": "expenses",
      "description": "School operational expenditures and receipts"
    },
    "/schools/{schoolId}/staff/{staffId}": {
      "schema": "staff",
      "description": "Staff roster, base salary, and allowance configuration"
    },
    "/schools/{schoolId}/payroll/{payrollId}": {
      "schema": "payroll",
      "description": "Monthly staff payroll disbursement records"
    },
    "/schools/{schoolId}/audit_logs/{logId}": {
      "schema": "audit_logs",
      "description": "Audit trails of financial and administrative operations"
    },
    "/schools/{schoolId}/term_schedules/{scheduleId}": {
      "schema": "term_schedules",
      "description": "Academic term schedules and calendar configurations"
    },
    "/schools/{schoolId}/remittances/{remittanceId}": {
      "schema": "remittances",
      "description": "Bursar cash and bank fee collections remittance deposits"
    },
    "/schools/{schoolId}/branding/{brandingId}": {
      "schema": "branding",
      "description": "Institutional branding assets and receipt headers for a given school"
    },
    "/schools/{schoolId}/system_users/{userId}": {
      "schema": "system_users",
      "description": "System accounts and administrative role credentials"
    },
    "/schools/{schoolId}/backups/{backupId}": {
      "schema": "backups",
      "description": "Historical fee snapshots and term archive records"
    }
  }
}
